<UserControl x:Class="Droideck.Views.MacroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Macros" Style="{StaticResource H1}"/>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,14,0,14">
      <StackPanel>
        <WrapPanel>
          <Button x:Name="RecBtn" Content="Record" Click="Rec_Click"/>
          <Button x:Name="PlayBtn" Content="Play" Style="{StaticResource AccentButton}" Click="Play_Click"/>
          <Button x:Name="StopBtn" Content="Stop" IsEnabled="False" Click="StopPlay_Click"/>
          <TextBlock Text="Loops" VerticalAlignment="Center" Margin="12,0,2,0" Foreground="{StaticResource MutedBrush}"/>
          <TextBox x:Name="LoopsBox" Text="1" Width="56" ToolTip="0 = repeat until stopped"/>
          <TextBlock Text="Speed" VerticalAlignment="Center" Margin="8,0,2,0" Foreground="{StaticResource MutedBrush}"/>
          <ComboBox x:Name="SpeedBox" Width="90" SelectedIndex="1">
            <ComboBoxItem Content="0.5x"/>
            <ComboBoxItem Content="1x"/>
            <ComboBoxItem Content="2x"/>
            <ComboBoxItem Content="4x"/>
          </ComboBox>
          <CheckBox x:Name="AllDevices" Content="Play on all connected devices" VerticalAlignment="Center"/>
        </WrapPanel>
        <WrapPanel>
          <Button Content="Wait" Click="AddWait_Click"/>
          <Button Content="Key" Click="AddKey_Click"/>
          <Button Content="Text" Click="AddText_Click"/>
          <Button Content="Edit delay" Click="EditDelay_Click"/>
          <Button Content="Move up" Click="Up_Click"/>
          <Button Content="Move down" Click="Down_Click"/>
          <Button Content="Delete step" Click="Delete_Click"/>
          <Button Content="Clear all" Style="{StaticResource DangerButton}" Click="ClearAll_Click"/>
          <Button Content="Save..." Click="Save_Click"/>
          <Button Content="Load..." Click="Load_Click"/>
        </WrapPanel>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="6,2,0,0"
                   Text="Tip: tick 'Record my taps into Macros' on the Mirror tab, then use the phone screen. Every tap, swipe, key and typed text lands here with its timing."/>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
      <ListBox x:Name="ActionList" SelectionMode="Single">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Describe}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="1" Text="{Binding DelayText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <TextBlock x:Name="InfoText" Grid.Row="3" Style="{StaticResource Muted}" Margin="4,8,0,0"/>
  </Grid>
</UserControl>
