<UserControl x:Class="Droideck.Views.MirrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="270"/>
    </Grid.ColumnDefinitions>

    <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,18,0">
      <Grid x:Name="ScreenHost" Background="Transparent" Focusable="True"
            MouseLeftButtonDown="Host_MouseDown" MouseLeftButtonUp="Host_MouseUp"
            MouseWheel="Host_MouseWheel" PreviewKeyDown="Host_KeyDown" TextInput="Host_TextInput">
        <Image x:Name="Screen" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="Hint" Text="Press Start to mirror the selected phone.&#x0a;Click and drag on the screen to tap and swipe. Type with your keyboard."
                   TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Mirror" Style="{StaticResource H1}" Margin="0,0,0,12"/>
        <Button x:Name="StartBtn" Content="Start mirroring" Style="{StaticResource AccentButton}" Margin="3,3,3,6" Click="Start_Click"/>
        <TextBlock x:Name="FpsText" Style="{StaticResource Muted}" Margin="6,0,0,10"/>

        <TextBlock Text="Navigation" FontWeight="SemiBold" Margin="4,6,0,4"/>
        <UniformGrid Columns="3">
          <Button Content="Back" Tag="4" Click="Key_Click"/>
          <Button Content="Home" Tag="3" Click="Key_Click"/>
          <Button Content="Recents" Tag="187" Click="Key_Click"/>
          <Button Content="Power" Tag="26" Click="Key_Click"/>
          <Button Content="Vol −" Tag="25" Click="Key_Click"/>
          <Button Content="Vol +" Tag="24" Click="Key_Click"/>
        </UniformGrid>
        <WrapPanel>
          <Button Content="Wake" Tag="224" Click="Key_Click"/>
          <Button Content="Notifications" Click="Notif_Click"/>
          <Button Content="Rotate" Click="Rotate_Click"/>
        </WrapPanel>

        <TextBlock Text="Type on the phone" FontWeight="SemiBold" Margin="4,12,0,0"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TypeBox" KeyDown="TypeBox_KeyDown"/>
          <Button Grid.Column="1" Content="Send" Click="SendText_Click"/>
        </Grid>

        <TextBlock Text="Capture" FontWeight="SemiBold" Margin="4,12,0,4"/>
        <WrapPanel>
          <Button Content="Screenshot" Click="Screenshot_Click"/>
          <Button x:Name="RecBtn" Content="Record" Click="Record_Click"/>
          <Button Content="Open captures" Click="OpenCaptures_Click"/>
        </WrapPanel>

        <CheckBox x:Name="MacroCheck" Content="Record my taps into Macros" Margin="4,14,0,0" Click="MacroCheck_Click"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
