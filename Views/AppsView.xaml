<UserControl x:Class="Droideck.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Apps" Style="{StaticResource H1}"/>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,14,0,14">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Debloat..." Click="Debloat_Click"/>
        <Button DockPanel.Dock="Right" Content="Install APK..." Style="{StaticResource AccentButton}" Click="Install_Click"/>
        <Button DockPanel.Dock="Right" Content="&#xE72C;" Style="{StaticResource IconButton}" ToolTip="Reload" Click="Reload_Click"/>
        <ComboBox DockPanel.Dock="Left" x:Name="FilterBox" Width="150" SelectedIndex="0" SelectionChanged="Filter_Changed">
          <ComboBoxItem Content="User apps"/>
          <ComboBoxItem Content="System apps"/>
          <ComboBoxItem Content="All apps"/>
          <ComboBoxItem Content="Disabled"/>
        </ComboBox>
        <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Search by package name"/>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="210"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Padding="8">
        <Grid>
          <ListBox x:Name="AppList" SelectionMode="Extended" AllowDrop="True" Drop="AppList_Drop"
                   SelectionChanged="AppList_SelectionChanged" MouseDoubleClick="AppList_DoubleClick">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Package}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="{Binding Tag}" Foreground="{Binding TagBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Text="Select a device to list its apps." IsHitTestVisible="False"/>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock x:Name="SelText" Text="Nothing selected" Style="{StaticResource Muted}" Margin="4,0,0,8" TextWrapping="Wrap"/>
          <Button Content="Launch" Click="Launch_Click"/>
          <Button Content="App info" Click="Info_Click"/>
          <Button Content="Force stop" Click="Stop_Click"/>
          <Button Content="Clear data" Click="Clear_Click"/>
          <Button Content="Permissions" Click="Perms_Click"/>
          <Button Content="Extract APK..." Click="Extract_Click"/>
          <Button Content="Disable" Click="Disable_Click"/>
          <Button Content="Enable" Click="Enable_Click"/>
          <Button Content="Uninstall" Style="{StaticResource DangerButton}" Click="Uninstall_Click"/>
          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,10,0,0"
                     Text="Drop .apk files on the list to install them. Double-click an app to launch it."/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
