<UserControl x:Class="Droideck.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="Devices" Style="{StaticResource H1}"/>
        <Border Style="{StaticResource Card}" Margin="0,14,0,16">
          <StackPanel>
            <ListBox x:Name="DeviceList" MinHeight="110" MaxHeight="260" SelectionChanged="DeviceList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Serial}" Style="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Badge}" Foreground="{Binding BadgeBrush}"
                               FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Text="No devices found. Plug in your phone with USB debugging on, or connect over Wi-Fi below."
                       Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="6,6,6,2"/>
            <WrapPanel Margin="0,12,0,0">
              <Button Content="Refresh" Click="Refresh_Click"/>
              <Button Content="Go wireless (USB device)" Click="GoWireless_Click"/>
              <Button Content="Disconnect" Click="Disconnect_Click"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Wireless debugging" Style="{StaticResource H2}"/>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Android 11+: Settings → Developer options → Wireless debugging → Pair device with pairing code. Enter the address and code shown there."/>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="PairHost" ToolTip="Pairing address, for example 192.168.1.20:37215"/>
              <TextBox x:Name="PairCode" Grid.Column="1" ToolTip="6 digit pairing code"/>
              <Button Grid.Column="2" Content="Pair" Style="{StaticResource AccentButton}" Click="Pair_Click"/>
            </Grid>
            <TextBlock Text="Pairing address  ·  code" Style="{StaticResource Muted}" Margin="4,0,0,10"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="ConnectHost" ToolTip="Device address, for example 192.168.1.20:5555"/>
              <Button Grid.Column="1" Content="Connect" Style="{StaticResource AccentButton}" Click="Connect_Click"/>
            </Grid>
            <TextBlock Text="Connect address (IP:port)" Style="{StaticResource Muted}" Margin="4,0,0,14"/>
            <TextBlock Text="Saved devices" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ListBox x:Name="SavedList" MinHeight="50" MaxHeight="150" MouseDoubleClick="SavedList_DoubleClick"/>
            <TextBlock Text="Double-click to reconnect." Style="{StaticResource Muted}" Margin="6,2,0,0"/>
            <Button Content="Remove saved" HorizontalAlignment="Left" Margin="0,8,0,0" Click="RemoveSaved_Click"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,46,0,0">
        <StackPanel>
          <TextBlock x:Name="InfoTitle" Text="No device selected" Style="{StaticResource H1}" FontSize="20"/>
          <TextBlock x:Name="InfoSub" Style="{StaticResource Muted}" Margin="0,2,0,14"/>
          <StackPanel x:Name="InfoPanel"/>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
