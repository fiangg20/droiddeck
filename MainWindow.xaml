<Window x:Class="Droideck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Droideck" Height="820" Width="1320" MinHeight="660" MinWidth="1060"
        Background="{StaticResource BgBrush}" Icon="app.ico"
        FontFamily="Segoe UI" FontSize="13"
        TextElement.Foreground="{StaticResource FgBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BgBrush}" BorderThickness="0,0,0,1" Padding="10,5">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="{StaticResource DangerBrush}" Margin="0,0,7,0"/>
          <TextBlock x:Name="StateText" Text="No device" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <ComboBox x:Name="DeviceBox" Width="300" SelectionChanged="DeviceBox_SelectionChanged"/>
          <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh devices" Click="Refresh_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="app.ico" Width="20" Height="20" Margin="4,0,9,0"/>
          <TextBlock Text="Droideck" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="CrumbText" Text="›   Devices" Style="{StaticResource Muted}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BgBrush}" BorderThickness="0,0,1,0" Padding="6,8">
        <StackPanel>
          <RadioButton x:Name="NavDevices" Style="{StaticResource StripeButton}" Content="&#xE772;" ToolTip="Devices" Tag="0" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource StripeButton}" Content="&#xE7F4;" ToolTip="Mirror" Tag="1" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource StripeButton}" Content="&#xE838;" ToolTip="Files" Tag="2" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource StripeButton}" Content="&#xE71D;" ToolTip="Apps" Tag="3" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource StripeButton}" Content="&#xE8A5;" ToolTip="Logcat" Tag="4" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource StripeButton}" Content="&#xE9D9;" ToolTip="Stats" Tag="5" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource StripeButton}" Content="&#xE756;" ToolTip="Terminal" Tag="6" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource StripeButton}" Content="&#xE768;" ToolTip="Macros" Tag="7" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource StripeButton}" Content="&#xE713;" ToolTip="Tools" Tag="8" Checked="Nav_Checked"/>
        </StackPanel>
      </Border>

      <Grid x:Name="Host" Grid.Column="1" Margin="12"/>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BgBrush}" BorderThickness="0,1,0,0" Padding="12,4">
      <DockPanel>
        <TextBlock x:Name="SerialText" DockPanel.Dock="Right" Style="{StaticResource Muted}"/>
        <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>

    <Grid x:Name="Overlay" Grid.RowSpan="3" Background="#E61E1F22" Visibility="Collapsed" Panel.ZIndex="50">
      <Border Style="{StaticResource Card}" Width="460" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="OverlayTitle" Text="Setting up ADB" Style="{StaticResource H1}"/>
          <TextBlock x:Name="OverlayText" Text="Downloading Android platform-tools from Google. This only happens once."
                     TextWrapping="Wrap" Margin="0,10,0,18" Foreground="{StaticResource MutedBrush}"/>
          <ProgressBar x:Name="OverlayBar" IsIndeterminate="True" Maximum="100"/>
          <StackPanel x:Name="OverlayButtons" Orientation="Horizontal" Margin="0,18,0,0" Visibility="Collapsed">
            <Button Content="Retry download" Style="{StaticResource AccentButton}" Click="Retry_Click"/>
            <Button Content="Browse for adb.exe" Click="BrowseAdb_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
